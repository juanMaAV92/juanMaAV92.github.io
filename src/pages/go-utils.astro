---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource-variable/fraunces';
import '../styles/interaction.css';

const repo = 'https://github.com/juanMaAV92/go-utils';
const canonical = 'https://juanmaav92.github.io/go-utils';
const blueprint = 'https://github.com/juanMaAV92/go-echo-blueprint';

const pageTitle = 'go-utils · Go utilities for AWS microservices';
const description =
  'Go utility library for AWS microservices: structured logging with OpenTelemetry trace correlation, typed errors, resilient HTTP client, RS256 JWT, Postgres/Redis/S3 adapters, SQS/SNS/EventBridge messaging and RBAC middleware. Config-from-env, interface-driven.';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'go-utils',
  description,
  url: canonical,
  codeRepository: repo,
  programmingLanguage: 'Go',
  runtimePlatform: 'Go 1.25',
  author: { '@type': 'Person', name: 'Juan Manuel Armero Viveros', url: 'https://juanmaav92.github.io/' },
  license: 'https://opensource.org/licenses/MIT',
};

const nodes: Record<string, { x: number; y: number }> = {
  a: { x: 160, y: 170 }, b: { x: 470, y: 110 }, c: { x: 820, y: 200 }, d: { x: 1180, y: 150 },
  e: { x: 1300, y: 470 }, f: { x: 980, y: 560 }, g: { x: 640, y: 480 }, h: { x: 300, y: 520 },
  i: { x: 120, y: 760 }, j: { x: 520, y: 780 }, k: { x: 900, y: 820 }, l: { x: 1240, y: 780 },
};
const edges: [string, string][] = [
  ['a', 'b'], ['b', 'c'], ['c', 'd'], ['d', 'e'], ['c', 'f'], ['f', 'e'],
  ['b', 'g'], ['g', 'f'], ['a', 'h'], ['h', 'g'], ['h', 'i'], ['i', 'j'],
  ['j', 'g'], ['j', 'k'], ['k', 'f'], ['k', 'l'], ['l', 'e'], ['g', 'k'],
];
const edgePaths = edges.map(([s, e], idx) => ({
  id: `edge-${idx}`,
  d: `M ${nodes[s].x} ${nodes[s].y} L ${nodes[e].x} ${nodes[e].y}`,
}));
const nodeList = Object.values(nodes);
const packets = [
  { edge: 'edge-0', dur: '12s', begin: '0s' },
  { edge: 'edge-3', dur: '14s', begin: '2.5s' },
  { edge: 'edge-10', dur: '13s', begin: '1.2s' },
  { edge: 'edge-16', dur: '15s', begin: '3.5s' },
];

// ── TOC (sidebar) ──
const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'principles', label: 'Principles' },
  { id: 'install', label: 'Install' },
  { id: 'packages', label: 'Packages', children: [
    { id: 'logger', label: 'Logger' },
    { id: 'errors', label: 'Errors' },
    { id: 'httpclient', label: 'HTTP Client' },
    { id: 'jwt', label: 'JWT' },
    { id: 'data-stores', label: 'Data stores' },
    { id: 'messaging', label: 'Messaging' },
    { id: 'identity', label: 'Identity' },
    { id: 'core', label: 'Core helpers' },
  ]},
  { id: 'ecosystem', label: 'Ecosystem' },
];

// ── Latest version (fetched from GitHub Releases at build time) ──
const FALLBACK_VERSION = '2.0.0';
let latestVersion = FALLBACK_VERSION;
let publishedAt: string | null = null;
try {
  const res = await fetch('https://api.github.com/repos/juanMaAV92/go-utils/releases/latest', {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    if (data.tag_name) {
      latestVersion = String(data.tag_name).replace(/^v/, '');
    }
    if (data.published_at) {
      publishedAt = new Date(data.published_at).toISOString().slice(0, 10);
    }
  }
} catch {
  // network error / rate limit → keep fallback
}
const majorVersion = latestVersion.split('.')[0];

// ── Code snippets (rendered with set:html to avoid JSX parser issues) ──
const installCode = `<span class="c-c">// v2+ carries the /v2 suffix (Go semantic import versioning)</span>
<span class="c-k">$</span> go get github.com/juanMaAV92/go-utils/v${majorVersion}

<span class="c-c">// import a package</span>
<span class="c-k">import</span> <span class="c-s">"github.com/juanMaAV92/go-utils/v${majorVersion}/logger"</span>`;

const loggerCode = `<span class="c-c">// Create once at startup</span>
log <span class="c-op">:=</span> logger.<span class="c-f">New</span>(<span class="c-s">"payments-api"</span>, env.<span class="c-f">GetEnvironment</span>())

<span class="c-c">// context-first — trace_id/span_id are pulled from the active span</span>
log.<span class="c-f">Info</span>(ctx, <span class="c-s">"process_payment"</span>, <span class="c-s">"payment captured"</span>,
    <span class="c-s">"amount"</span>, <span class="c-v">50000</span>, <span class="c-s">"currency"</span>, <span class="c-s">"COP"</span>)`;

const loggerOut = `{"time":"2026-03-22T10:15:30.12Z","level":"INFO","service":"payments-api","step":"process_payment","message":"payment captured","trace_id":"4bf9...","span_id":"00f0...","amount":50000,"currency":"COP"}`;

const errorsCode = `<span class="c-c">// Typed, predefined errors</span>
<span class="c-k">return</span> errors.<span class="c-f">ErrNotFound</span>()
<span class="c-k">return</span> errors.<span class="c-f">ErrBadRequest</span>().<span class="c-f">WithMessage</span>(<span class="c-s">"email is required"</span>)

<span class="c-c">// Fully custom</span>
<span class="c-k">return</span> errors.<span class="c-f">New</span>(http.StatusConflict, <span class="c-s">"CONFLICT"</span>, []<span class="c-t">string</span>{<span class="c-s">"already exists"</span>})

<span class="c-c">// Wire the Echo handler once — maps *ErrorResponse to the right status + JSON</span>
e.HTTPErrorHandler <span class="c-op">=</span> echoerr.<span class="c-f">HTTPErrorHandler</span>`;

const httpCode = `c <span class="c-op">:=</span> httpclient.<span class="c-f">New</span>(log,
    httpclient.<span class="c-f">WithBaseURL</span>(<span class="c-s">"https://api.example.com"</span>),
    httpclient.<span class="c-f">WithRetryCount</span>(<span class="c-v">3</span>),
    httpclient.<span class="c-f">WithServiceName</span>(<span class="c-s">"billing"</span>),
)

<span class="c-c">// W3C trace context is injected automatically; bodies are never logged</span>
resp, err <span class="c-op">:=</span> c.<span class="c-f">Post</span>(ctx, <span class="c-s">"/invoices"</span>, invoice)
<span class="c-k">var</span> out Invoice
_ <span class="c-op">=</span> resp.<span class="c-f">JSON</span>(&out)`;

const jwtCode = `svc, _ <span class="c-op">:=</span> jwt.<span class="c-f">New</span>(privatePEM, publicPEM, <span class="c-s">"auth-service"</span>)

<span class="c-c">// Sign</span>
claims <span class="c-op">:=</span> MyClaims{RegisteredClaims: svc.<span class="c-f">RegisteredClaims</span>(time.Hour), UserID: <span class="c-s">"u_1"</span>}
token, _ <span class="c-op">:=</span> svc.<span class="c-f">GenerateToken</span>(&claims)

<span class="c-c">// Validate — RS256 only, exp required, issuer checked</span>
got, err <span class="c-op">:=</span> jwt.<span class="c-f">ValidateToken</span>[MyClaims](svc, token)`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%96%AE%3C/text%3E%3C/svg%3E" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Juan Manuel Armero Viveros" />
    <meta name="theme-color" content="#0b0d10" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://juanmaav92.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </head>

  <body class="world-go-utils">
    <div class="bg" aria-hidden="true">
      <div class="mesh-glow"></div>

      <svg class="circuits" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
        <g class="trace">
          <path d="M -20 90 H 180 V 40 H 360" />
          <path d="M -20 860 H 240 V 800 H 430 V 740" />
          <path d="M 1460 130 H 1230 V 200 H 1040" />
          <path d="M 1460 720 H 1250 V 660 H 1080 V 720" />
          <path d="M 720 920 V 760 H 560" />
        </g>
        <g class="trace-pads">
          <circle cx="360" cy="40" r="4" /><circle cx="430" cy="740" r="4" />
          <circle cx="1040" cy="200" r="4" /><circle cx="1080" cy="720" r="4" />
          <circle cx="560" cy="760" r="4" />
        </g>
      </svg>

      <svg class="mesh" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          {edgePaths.map((p) => <path id={p.id} d={p.d} />)}
        </defs>
        <g class="edges">
          {edgePaths.map((p) => <use href={`#${p.id}`} />)}
        </g>
        <g class="dnodes">
          {nodeList.map((n, idx) => (
            <circle cx={n.x} cy={n.y} r="3.5" class="dnode" style={`--nd: ${idx * 0.4}s`} />
          ))}
        </g>
        <g class="packets">
          {packets.map((pk) => (
            <circle r="3" class="packet">
              <animateMotion dur={pk.dur} begin={pk.begin} repeatCount="indefinite" rotate="auto">
                <mpath href={`#${pk.edge}`} />
              </animateMotion>
            </circle>
          ))}
        </g>
      </svg>

      <div class="vignette"></div>
      <div class="center-veil"></div>
      <div class="grain"></div>
    </div>

    <!-- ── TOP BAR (sticky) ────────────────────── -->
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">~/</a>
        <span class="crumb-sep">/</span>
        <a class="crumb-link" href="/">portfolio</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">go-utils</span>
        <nav class="topbar-links">
          <a href={repo} target="_blank" rel="noopener">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <div class="wrap">
      <!-- ── SIDEBAR (sticky) ──────────────────── -->
      <aside class="toc" aria-label="Table of contents">
        <p class="toc-title"><span class="sigil">#</span> on this page</p>
        <ul class="toc-list">
          {toc.map((item) => (
            <li class="toc-item">
              <a class="toc-link" href={`#${item.id}`} data-toc={item.id}>
                <span class="toc-arrow" aria-hidden="true">›</span>{item.label}
              </a>
              {item.children && (
                <ul class="toc-sub">
                  {item.children.map((c) => (
                    <li>
                      <a class="toc-link toc-link-sub" href={`#${c.id}`} data-toc={c.id}>
                        <span class="toc-arrow" aria-hidden="true">·</span>{c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <a class="toc-back" href="/">← back to portfolio</a>
      </aside>

      <!-- ── MOBILE TOC (collapsed) ────────────── -->
      <details class="toc-mobile">
        <summary>
          <span class="sigil">#</span> on this page
          <span class="toc-mobile-arrow" aria-hidden="true">+</span>
        </summary>
        <ul class="toc-list">
          {toc.map((item) => (
            <li class="toc-item">
              <a class="toc-link" href={`#${item.id}`}>{item.label}</a>
              {item.children && (
                <ul class="toc-sub">
                  {item.children.map((c) => (
                    <li><a class="toc-link toc-link-sub" href={`#${c.id}`}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </details>

      <!-- ── CONTENT ───────────────────────────── -->
      <article class="content">

        <section id="overview" class="hero">
          <p class="prompt rise" style="--d: 60ms"><span class="sigil">$</span> whoami go-utils</p>
          <h1 class="name rise" style="--d: 180ms">go<span class="surname">-utils</span></h1>
          <p class="lede rise" style="--d: 300ms">
            Go utility library for AWS microservices — structured logging with trace correlation,
            typed errors, a resilient HTTP client, RS256 JWT, Postgres/Redis/S3 adapters and
            SQS/SNS/EventBridge messaging. <em>Observability-first, config-from-env, interface-driven.</em>
          </p>
          <div class="badges rise" style="--d: 420ms" aria-label="Build info">
            <span class="chip chip-version">v{latestVersion}{publishedAt && <span class="chip-date"> · {publishedAt}</span>}</span>
            <span class="chip">Go 1.25</span>
            <span class="chip">AWS SDK v2</span>
            <span class="chip">OpenTelemetry</span>
            <span class="chip">MIT</span>
          </div>
          <div class="cta rise" style="--d: 510ms">
            <a class="btn-primary" href={repo} target="_blank" rel="noopener">
              <span class="sigil">→</span> View on GitHub<span class="goto">↗</span>
            </a>
            <a class="btn-ghost" href="#packages">Browse packages ↓</a>
            <a class="btn-ghost" href={blueprint} target="_blank" rel="noopener">Echo blueprint ↗</a>
          </div>
        </section>

        <section id="principles" class="block">
          <h2 class="section-head reveal">
            <span class="sigil">$</span> <span class="cmd">cat</span> <span class="path">~/principles.md</span>
            <a class="anchor" href="#principles" aria-label="Anchor">#</a>
          </h2>
          <div class="principles">
            <article class="principle reveal">
              <span class="p-num">01</span>
              <h3>Observability-first</h3>
              <p>Every package emits OpenTelemetry spans, and the logger injects <code>trace_id</code>/<code>span_id</code> from the context into every line — logs and traces correlate out of the box.</p>
            </article>
            <article class="principle reveal">
              <span class="p-num">02</span>
              <h3>Config from env</h3>
              <p>Every adapter has <code>ConfigFromEnv(prefix)</code>. Same shape everywhere — <code>DB_*</code>, <code>REDIS_*</code>, <code>SQS_*</code> — so wiring a service is boilerplate-free and 12-factor by default.</p>
            </article>
            <article class="principle reveal">
              <span class="p-num">03</span>
              <h3>Interface-driven</h3>
              <p>Each package exposes an interface with an unexported implementation. Depend on the interface, mock it in tests, swap the backend without touching callers.</p>
            </article>
          </div>
        </section>

        <section id="install" class="block">
          <h2 class="section-head reveal">
            <span class="sigil">$</span> <span class="cmd">cat</span> <span class="path">~/install.md</span>
            <a class="anchor" href="#install" aria-label="Anchor">#</a>
          </h2>
          <pre class="code reveal"><code set:html={installCode}></code></pre>
          <p class="setup-foot reveal">
            <span class="sigil">#</span> Public module — no auth needed. Requires Go 1.25+. AWS clients use the standard credential chain (env, shared config, IAM role); no hardcoded credentials.
          </p>
        </section>

        <section id="packages" class="block">
          <h2 class="section-head reveal">
            <span class="sigil">$</span> <span class="cmd">go</span> <span class="path">list ./...</span>
            <span class="count">18 pkgs</span>
            <a class="anchor" href="#packages" aria-label="Anchor">#</a>
          </h2>

          <article id="logger" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> logger <span class="mod-tag">Structured JSON</span><a class="anchor anchor-sub" href="#logger" aria-label="Anchor">#</a></h3>
              <p>Flat JSON to stdout on top of <code>slog</code>. When a span is active, <code>trace_id</code> and <code>span_id</code> are injected automatically — no manual plumbing.</p>
            </header>
            <pre class="code"><code set:html={loggerCode}></code></pre>
            <p class="mod-out-label">Output:</p>
            <pre class="code out"><code set:html={loggerOut}></code></pre>
          </article>

          <article id="errors" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> errors <span class="mod-tag">Typed + Echo</span><a class="anchor anchor-sub" href="#errors" aria-label="Anchor">#</a></h3>
              <p>A single <code>ErrorResponse</code> type with HTTP code, error code and messages. Predefined constructors for every status, plus a drop-in Echo handler.</p>
            </header>
            <pre class="code"><code set:html={errorsCode}></code></pre>
          </article>

          <article id="httpclient" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> httpclient <span class="mod-tag">Resilient client</span><a class="anchor anchor-sub" href="#httpclient" aria-label="Anchor">#</a></h3>
              <p>Resty-based client with retries, timeouts and W3C trace propagation. Request/response bodies are never logged — only metadata — so credentials and tokens don't leak.</p>
            </header>
            <pre class="code"><code set:html={httpCode}></code></pre>
          </article>

          <article id="jwt" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> security/jwt <span class="mod-tag">RS256</span><a class="anchor anchor-sub" href="#jwt" aria-label="Anchor">#</a></h3>
              <p>Generic RS256 signing and validation over any claims struct. Validation enforces <em>RS256 only</em>, requires <code>exp</code>, and checks the issuer — closing the classic algorithm-substitution and never-expiring-token gaps.</p>
            </header>
            <pre class="code"><code set:html={jwtCode}></code></pre>
          </article>

          <article id="data-stores" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> data stores <span class="mod-tag">postgres · redis · s3</span><a class="anchor anchor-sub" href="#data-stores" aria-label="Anchor">#</a></h3>
              <p>Interface-driven persistence adapters, each with <code>ConfigFromEnv</code> and OTel tracing.</p>
            </header>
            <ul class="mod-feats">
              <li><code>database/postgresql</code> — GORM wrapper: <code>Create</code>, <code>Find</code>/<code>FindMany</code> with pagination, <code>UpdateWhere</code>, <code>WithTransaction</code>; pg error codes mapped to sentinels (cause preserved for <code>errors.Is</code>)</li>
              <li><code>cache/redis</code> — typed <code>Set</code>/<code>Get</code>/<code>GetOrSet</code>, sets, pub/sub, atomic <code>GETDEL</code>, TTL/NX/XX options</li>
              <li><code>storage/s3</code> — <code>Get</code>/<code>Put</code>/<code>Head</code>/<code>Delete</code> plus presigned upload/download URLs</li>
            </ul>
          </article>

          <article id="messaging" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> messaging <span class="mod-tag">sqs · sns · scheduler</span><a class="anchor anchor-sub" href="#messaging" aria-label="Anchor">#</a></h3>
              <p>Event-driven building blocks with trace context flowing through message attributes.</p>
            </header>
            <ul class="mod-feats">
              <li><code>sqs</code> — batch producer + worker-pool consumer that transparently unwraps the SNS envelope; backoff on poll errors and a graceful drain on shutdown (no duplicate delivery)</li>
              <li><code>sns</code> — producer that propagates W3C trace context via message attributes</li>
              <li><code>scheduler</code> — one-time EventBridge schedules with a webhook-via-Lambda helper and a <code>Disabled</code> flag that survives updates</li>
            </ul>
          </article>

          <article id="identity" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> middleware/identity <span class="mod-tag">RBAC</span><a class="anchor anchor-sub" href="#identity" aria-label="Anchor">#</a></h3>
              <p>Echo middleware that reads a gateway-injected identity (user, roles, permissions) from request headers into the context.</p>
            </header>
            <ul class="mod-feats">
              <li><code>HasPermission</code> / <code>HasAnyPermission</code> / <code>RequireCapability</code> with <code>all:all</code> superadmin</li>
              <li>Wildcard patterns (<code>orders:*</code>) and role checks</li>
              <li><code>ToRequestOptions</code> forwards the identity downstream — scoped forwarding no longer leaks superadmin past the pattern</li>
            </ul>
          </article>

          <article id="core" class="mod reveal">
            <header class="mod-head">
              <h3><span class="sigil">▸</span> core helpers <span class="mod-tag">env · validator · telemetry · …</span><a class="anchor anchor-sub" href="#core" aria-label="Anchor">#</a></h3>
              <p>The small, dependency-light pieces every service reuses.</p>
            </header>
            <ul class="mod-feats">
              <li><code>env</code> — typed env parsing (<code>GetEnvAsInt/Duration/Bool/Slice</code>, <code>MustHave</code>)</li>
              <li><code>validator</code> — struct validation with field-aware messages, backed by go-playground</li>
              <li><code>telemetry</code> — one-call OTLP setup; parent-based sampling that honors upstream decisions</li>
              <li><code>pointers</code> · <code>timeutil</code> — generics and date helpers</li>
              <li><code>testutil/echo</code> · <code>testutil/http</code> — request builders and JSON assertions for handler tests</li>
            </ul>
          </article>
        </section>

        <section id="ecosystem" class="block">
          <h2 class="section-head reveal">
            <span class="sigil">$</span> <span class="cmd">cat</span> <span class="path">~/ecosystem.md</span>
            <a class="anchor" href="#ecosystem" aria-label="Anchor">#</a>
          </h2>
          <div class="compat reveal">
            <div class="compat-row">
              <span class="compat-fw">Blueprint</span>
              <span class="compat-arrow" aria-hidden="true">→</span>
              <span class="compat-note">Production Echo microservice template built on go-utils: <a class="compat-link" href={blueprint} target="_blank" rel="noopener">go-echo-blueprint ↗</a></span>
            </div>
            <div class="compat-row">
              <span class="compat-fw">Built on</span>
              <span class="compat-arrow" aria-hidden="true">→</span>
              <span class="compat-note"><code>aws-sdk-go-v2</code>, <code>gorm</code>, <code>go-redis</code>, <code>resty</code>, <code>go-playground/validator</code>, <code>golang-jwt</code>, <code>opentelemetry-go</code></span>
            </div>
            <div class="compat-row">
              <span class="compat-fw">Framework</span>
              <span class="compat-arrow" aria-hidden="true">→</span>
              <span class="compat-note">HTTP helpers target <code>Echo</code>; everything else (logging, messaging, stores, jwt) is framework-agnostic</span>
            </div>
          </div>
        </section>

        <footer class="foot">
          <p class="line"><span class="sigil">$</span> <span class="muted">open source · MIT · observability-first</span><span class="cursor" aria-hidden="true">▮</span></p>
        </footer>
      </article>
    </div>

    <script>
      const bg = document.querySelector<HTMLElement>('.bg');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Parallax de las capas de fondo
      if (bg && !reduce) {
        let raf = 0;
        window.addEventListener('pointermove', (e) => {
          if (raf) return;
          raf = requestAnimationFrame(() => {
            const dx = e.clientX / window.innerWidth - 0.5;
            const dy = e.clientY / window.innerHeight - 0.5;
            const mesh = bg.querySelector<HTMLElement>('.mesh');
            const circ = bg.querySelector<HTMLElement>('.circuits');
            const glow = bg.querySelector<HTMLElement>('.mesh-glow');
            if (mesh) mesh.style.transform = `translate(${dx * 22}px, ${dy * 22}px)`;
            if (circ) circ.style.transform = `translate(${dx * -14}px, ${dy * -14}px)`;
            if (glow) glow.style.transform = `translate(${dx * 30}px, ${dy * 30}px)`;
            raf = 0;
          });
        });
      }

      // Reveal on scroll
      const reveals = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.04 }
        );
        reveals.forEach((el) => io.observe(el));
      }

      // ── Scroll-spy del TOC ──
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
      if (tocLinks.length && 'IntersectionObserver' in window) {
        const sections = Array.from(tocLinks)
          .map((a) => document.getElementById(a.dataset.toc!))
          .filter((el): el is HTMLElement => !!el);

        const setActive = (id: string) => {
          tocLinks.forEach((a) => {
            a.classList.toggle('is-active', a.dataset.toc === id);
          });
        };

        const spy = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length) {
              setActive(visible[0].target.id);
            }
          },
          { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
        );
        sections.forEach((s) => spy.observe(s));

        tocLinks.forEach((a) => {
          a.addEventListener('click', (e) => {
            const id = a.dataset.toc;
            if (!id) return;
            const target = document.getElementById(id);
            if (!target) return;
            e.preventDefault();
            setActive(id);
            const top = target.getBoundingClientRect().top + window.scrollY - 70;
            window.scrollTo({ top, behavior: 'smooth' });
            history.replaceState(null, '', `#${id}`);
          });
        });
      }

      // Auto-close del TOC mobile después de navegar
      document.querySelectorAll<HTMLDetailsElement>('.toc-mobile').forEach((d) => {
        d.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => { d.open = false; });
        });
      });
    </script>
  </body>
</html>

