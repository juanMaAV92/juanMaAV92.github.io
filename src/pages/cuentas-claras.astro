---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/interaction.css';

const canonical = 'https://juanmaav92.github.io/cuentas-claras';

// Recorrido: cada principio del producto es el pie de su captura.
const slides = [
  {
    tab: 'El mes',
    src: '/cuentas-claras/mes-actual.webp',
    width: 1600,
    height: 1316,
    alt: 'Vista del mes con gastos por grupo, pagados, pendientes en ámbar y un sobregasto en rojo',
    title: 'Planear antes de registrar',
    caption: 'Primero se reparte lo que entra; después se marcan los pagos. Lo pendiente va en ámbar y el rojo solo aparece con un sobregasto real. Cada gasto tiene responsable, incluso una abuela que no usa la app.',
  },
  {
    tab: 'Inversiones',
    src: '/cuentas-claras/inversiones.webp',
    width: 1600,
    height: 1772,
    alt: 'Inversiones: composición por tipo de activo y posiciones valoradas en COP',
    title: 'El patrimonio como segunda capa',
    caption: 'CDT, ETF, cripto y divisas valorados en COP con la TRM, cada uno con su proveedor de precio declarado.',
  },
  {
    tab: 'Evolución',
    src: '/cuentas-claras/evolucion.webp',
    width: 1600,
    height: 1000,
    alt: 'Evolución del patrimonio mes a mes, por tipo de activo',
    title: 'Mes a mes, sin copiar precios',
    caption: 'Snapshots mensuales del patrimonio por tipo de activo, con aportes y retiros separados del rendimiento.',
  },
  {
    tab: 'Créditos',
    src: '/cuentas-claras/credito-detalle.webp',
    width: 1600,
    height: 1000,
    alt: 'Simulador de crédito hipotecario con cuota, intereses y seguros',
    title: 'Simular antes de endeudarse',
    caption: 'Cuota, intereses y seguros con los supuestos a la vista, y abonos a capital para comparar escenarios.',
  },
  {
    tab: 'Primer mes',
    src: '/cuentas-claras/onboarding.webp',
    width: 1600,
    height: 1000,
    alt: 'Guía de cuatro pasos para preparar el primer mes de un presupuesto nuevo',
    title: 'Una guía que no estorba',
    caption: 'Onboarding contextual de cuatro pasos para el primer presupuesto, sin bloquear el resto de la app.',
  },
];

const phones = [
  { src: '/cuentas-claras/m-home.webp', alt: 'Inicio en el celular', caption: 'PWA instalable: el uso diario es desde el celular.' },
  { src: '/cuentas-claras/m-mes-actual.webp', alt: 'Vista del mes en el celular', caption: 'Marcar un pago es un toque.' },
];

const stack = ['TypeScript', 'React 19', 'TanStack', 'Hono', 'SQLite + Drizzle', 'Better Auth · passkeys', 'Vitest · Playwright', 'Docker · Dokploy'];

const decisions = [
  {
    title: 'Cero lógica de negocio en el front',
    desc: 'Prorrateos, valoraciones y cierres de mes viven en la API. El front solo pinta, con un contrato tipado de punta a punta (Hono RPC).',
  },
  {
    title: 'Sin fallback silencioso entre precios',
    desc: 'Cada activo tiene un proveedor fijo. Si falla, muestro el último precio marcado como viejo antes que mezclar fuentes sin avisar.',
  },
  {
    title: 'Solo se entra por invitación',
    desc: 'Registro cerrado: tokens de un solo uso, hasheados, que vencen en 7 días. Cualquier token inválido responde el mismo 404.',
  },
];

const built = ['Presupuesto personal y compartido', 'Inversiones y evolución del patrimonio', 'Simulador de créditos', 'Invitaciones, roles y passkeys'];
const next = ['Suscripciones y su costo anual real', 'Seguimiento de un crédito ya adquirido', 'Activos físicos: vivienda y carro'];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cuentas Claras',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description: 'App self-hosted para planificar gastos personales y compartidos, seguir su ejecución durante el mes e inversiones, con evolución del patrimonio.',
  url: canonical,
  author: { '@type': 'Person', name: 'Juan Manuel Armero Viveros', url: 'https://juanmaav92.github.io/' },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cuentas Claras · Presupuesto compartido e inversiones (caso de estudio)</title>
    <meta name="description" content="Caso de estudio de Cuentas Claras: app self-hosted de presupuesto personal y compartido e inversiones que reemplazó un Google Sheet. TypeScript, Hono, SQLite y PWA. Proyecto de Juan Manuel Armero Viveros." />
    <meta name="author" content="Juan Manuel Armero Viveros" />
    <meta name="theme-color" content="#fbf6ee" />
    <link rel="icon" href="/cuentas-claras/logo.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="Cuentas Claras · Presupuesto compartido e inversiones" />
    <meta property="og:description" content="Planear el mes en pareja, ver el margen y seguir el patrimonio. App self-hosted en uso real." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://juanmaav92.github.io/cuentas-claras/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </head>

  <body>
    <header class="nav-wrap">
      <div class="nav">
        <a class="brand" href="#top">
          <img src="/cuentas-claras/logo.svg" alt="" width="32" height="32" />
          <span>Cuentas Claras</span>
        </a>
        <nav class="nav-links">
          <span class="status">● En uso</span>
          <a href="/" class="ghost">← Portafolio</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero">
        <img class="hero-logo rise" style="--d: 0ms" src="/cuentas-claras/logo.svg" alt="" width="72" height="72" />
        <p class="eyebrow rise" style="--d: 60ms">Caso de estudio · producto self-hosted</p>
        <h1 class="rise" style="--d: 120ms">Las cuentas claras <em>y el chocolate espeso.</em></h1>
        <p class="tagline rise" style="--d: 180ms">Planear el mes en pareja, sin un sheet de por medio.</p>
        <p class="lede rise" style="--d: 240ms">
          Reemplazó el Google Sheet con el que planeábamos el presupuesto familiar. Reparte lo que
          entra cada mes, muestra quién paga qué y cuánto margen queda y, como segunda capa, sigue
          inversiones y patrimonio.
        </p>
        <ul class="meta rise" style="--d: 300ms">
          <li><span>Rol</span>Producto, diseño, desarrollo y operación</li>
          <li><span>Stack</span>TypeScript · React · Hono · SQLite</li>
          <li><span>Estado</span>En uso real · repo privado</li>
        </ul>
      </section>

      <section class="showcase rise" style="--d: 360ms">
        <button type="button" class="frame zoomable" data-group="hero" aria-label="Ampliar captura">
          <img src="/cuentas-claras/home.webp" alt="Inicio de Cuentas Claras: cuánto queda libre en el mes, por persona y por grupo" width="1600" height="1000" loading="eager" />
          <span class="zoom-hint" aria-hidden="true">Ampliar ⤢</span>
        </button>
        <p class="note">Capturas de una instancia local con datos ficticios.</p>
      </section>

      <!-- PROBLEMA -->
      <section class="problem block">
        <p class="kicker">El problema</p>
        <h2>Un sheet sirve para <em>anotar</em> lo que pasó. Lo difícil es <em>decidir</em> qué va a pasar.</h2>
        <p class="sub">
          Cada mes había que copiar la hoja, arreglar fórmulas a mano y adivinar quién ya había pagado
          qué. Funcionaba mientras nadie rompiera una fórmula.
        </p>
      </section>

      <!-- RECORRIDO -->
      <section class="block tour" aria-labelledby="tour-title">
        <p class="kicker center">Recorrido</p>
        <h2 class="center" id="tour-title">Del plan del mes al patrimonio</h2>
        <p class="sub center">Ana y Luis, un presupuesto compartido, una abuela que participa sin cuenta y tres meses de historia.</p>

        <div class="carousel" aria-roledescription="carrusel" aria-label="Pantallas de Cuentas Claras">
          <div class="tabs" role="group" aria-label="Elegir pantalla">
            {slides.map((s, i) => (
              <button type="button" class="tab" data-i={i} aria-current={i === 0 ? 'true' : undefined}>{s.tab}</button>
            ))}
          </div>
          <div class="viewport">
            <button type="button" class="arrow prev" aria-label="Pantalla anterior" disabled>‹</button>
            <div class="track" tabindex="0" aria-label="Capturas, usa las flechas para cambiar">
              {slides.map((s, i) => (
                <figure class="slide" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${slides.length}: ${s.tab}`}>
                  <button type="button" class="frame zoomable" data-group="tour" aria-label={`Ampliar captura: ${s.tab}`}>
                    <img src={s.src} alt={s.alt} width={s.width} height={s.height} loading={i === 0 ? 'eager' : 'lazy'} />
                    <span class="zoom-hint" aria-hidden="true">Ver completa ⤢</span>
                  </button>
                  <figcaption>
                    <strong>{s.title}</strong>
                    <span>{s.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
            <button type="button" class="arrow next" aria-label="Pantalla siguiente">›</button>
          </div>
          <p class="sr-only" aria-live="polite"></p>
        </div>

        <div class="phones">
          {phones.map((p) => (
            <figure class="phone">
              <button type="button" class="frame zoomable" data-group="mobile" aria-label={`Ampliar captura: ${p.alt}`}>
                <img src={p.src} alt={p.alt} width="780" height="1688" loading="lazy" />
              </button>
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- POR DENTRO -->
      <section class="block inside">
        <p class="kicker center">Por dentro</p>
        <h2 class="center">Pequeña en usuarios, seria en ingeniería</h2>
        <p class="sub center">La usan dos personas, pero maneja dinero real: un SPA y una API en un solo contenedor, operados como producción.</p>
        <ul class="chips">{stack.map((s) => <li>{s}</li>)}</ul>
        <div class="decisions">
          {decisions.map((d) => (
            <article class="decision">
              <h3>{d.title}</h3>
              <p>{d.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ESTADO + CTA -->
      <section class="block closing">
        <div class="status-cols">
          <div>
            <h3>Ya en uso</h3>
            <ul>{built.map((b) => <li>{b}</li>)}</ul>
          </div>
          <div>
            <h3>Siguiente</h3>
            <ul class="todo">{next.map((n) => <li>{n}</li>)}</ul>
          </div>
        </div>
        <div class="cta">
          <h2>Software que uso todos los meses, construido como si fuera para muchos.</h2>
          <p>El repositorio es privado porque contiene la operación de un producto en uso. Si quieres ver el código o hablar de cómo lo construí, conversemos.</p>
          <a class="btn" href="/#contacto">Hablemos →</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span class="foot-brand"><img src="/cuentas-claras/logo.svg" alt="" width="20" height="20" />Cuentas Claras · self-hosted · en uso</span>
      <span>By <a href="/">Juan Manuel Armero Viveros</a></span>
    </footer>

    <!-- Captura ampliada: se abre al pulsar una captura; ‹ › recorren su grupo, Esc o clic fuera cierra. -->
    <dialog class="lightbox" aria-label="Captura ampliada">
      <div class="lb-inner">
        <img alt="" />
      </div>
      <button type="button" class="lb-close" aria-label="Cerrar">✕</button>
      <button type="button" class="lb-nav lb-prev" aria-label="Captura anterior">‹</button>
      <button type="button" class="lb-nav lb-next" aria-label="Captura siguiente">›</button>
      <p class="lb-count" aria-live="polite"></p>
    </dialog>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal al hacer scroll
      const reveals = document.querySelectorAll('.block');
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.04 }
        );
        reveals.forEach((el) => io.observe(el));
      }

      // Carrusel (scroll-snap nativo; el JS solo sincroniza tabs, flechas y teclado)
      const track = document.querySelector<HTMLElement>('.track');
      const slideEls = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
      const tabEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
      const prev = document.querySelector<HTMLButtonElement>('.arrow.prev');
      const next = document.querySelector<HTMLButtonElement>('.arrow.next');
      const live = document.querySelector<HTMLElement>('.carousel .sr-only');
      let current = 0;

      const setActive = (i: number) => {
        current = i;
        tabEls.forEach((t, j) => (j === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === slideEls.length - 1;
        if (live) live.textContent = slideEls[i]?.getAttribute('aria-label') ?? '';
      };
      const go = (i: number) => {
        if (!track) return;
        const clamped = Math.max(0, Math.min(slideEls.length - 1, i));
        track.scrollTo({ left: clamped * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
        setActive(clamped);
      };
      tabEls.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.i))));
      prev?.addEventListener('click', () => go(current - 1));
      next?.addEventListener('click', () => go(current + 1));
      track?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
      });
      let scrollTimer = 0;
      track?.addEventListener('scroll', () => {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== current) setActive(i);
        }, 80);
      });

      // Lightbox con navegación dentro del grupo de la captura
      const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
      const lbImg = dialog?.querySelector('img');
      const lbCount = dialog?.querySelector<HTMLElement>('.lb-count');
      const lbPrev = dialog?.querySelector<HTMLButtonElement>('.lb-prev');
      const lbNext = dialog?.querySelector<HTMLButtonElement>('.lb-next');
      let group: HTMLButtonElement[] = [];
      let idx = 0;
      let opener: HTMLButtonElement | null = null;

      const show = (i: number) => {
        if (!dialog || !lbImg) return;
        idx = Math.max(0, Math.min(group.length - 1, i));
        const img = group[idx]?.querySelector('img');
        if (!img) return;
        lbImg.src = img.currentSrc || img.src;
        lbImg.alt = img.alt;
        dialog.scrollTop = 0;
        // Capturas de celular: caben completas en la pantalla, sin scroll ni zoom gigante.
        dialog.classList.toggle('fit', group[idx]?.dataset.group === 'mobile');
        const multi = group.length > 1;
        if (lbPrev) { lbPrev.hidden = !multi; lbPrev.disabled = idx === 0; }
        if (lbNext) { lbNext.hidden = !multi; lbNext.disabled = idx === group.length - 1; }
        if (lbCount) lbCount.textContent = multi ? `${idx + 1} / ${group.length}` : '';
      };
      document.querySelectorAll<HTMLButtonElement>('.zoomable').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!dialog) return;
          group = Array.from(document.querySelectorAll<HTMLButtonElement>(`.zoomable[data-group="${btn.dataset.group}"]`));
          opener = btn;
          show(group.indexOf(btn));
          dialog.showModal();
        });
      });
      lbPrev?.addEventListener('click', () => show(idx - 1));
      lbNext?.addEventListener('click', () => show(idx + 1));
      dialog?.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === dialog || t.classList.contains('lb-inner')) dialog.close();
      });
      dialog?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(idx + 1);
        if (e.key === 'ArrowLeft') show(idx - 1);
      });
      dialog?.addEventListener('close', () => {
        const target = group[idx] ?? opener;
        if (target?.dataset.group === 'tour') go(group.indexOf(target));
        target?.focus({ preventScroll: true });
      });
    </script>

    <style is:global>
      :root {
        --bg: #fbf6ee;
        --surface: #f3eadc;
        --card: #ffffff;
        --border: #eadfcf;
        --frame: #e2d4bf;
        --fg: #2b1d16;
        --muted: #574436;
        --faint: #6f5b4c;
        --choco: #3a2015;
        --choco-2: #5a3423;
        --cocoa: #8a5a3c;
        --cream: #fff8ec;
        --positive: #17643f;
        --positive-bg: #e3f0e8;
        --serif: 'Fraunces Variable', Georgia, serif;
        --sans: 'Schibsted Grotesk Variable', system-ui, sans-serif;
        --mono: 'JetBrains Mono', monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg); color: var(--fg); font-family: var(--sans);
        line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: clip;
      }
      a { color: inherit; }
      img { max-width: 100%; height: auto; display: block; }
    </style>

    <style>
      main { max-width: 1080px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 1.5rem); }
      .block { padding: 4.5rem 0; }
      .center { text-align: center; }
      h1, h2, h3 { font-family: var(--serif); color: var(--choco); font-weight: 500; }
      h2 { font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.18; letter-spacing: -0.01em; }
      em { font-style: italic; color: var(--cocoa); }
      .kicker, .eyebrow {
        font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--faint); margin-bottom: 0.9rem;
      }
      .sub { color: var(--muted); font-size: 1.05rem; max-width: 58ch; margin: 1rem auto 0; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      /* NAV */
      .nav-wrap {
        position: sticky; top: 0; z-index: 20;
        background: rgba(251, 246, 238, 0.9); backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }
      .nav {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        max-width: 1080px; margin: 0 auto; padding: 0.6rem clamp(1rem, 4vw, 1.5rem); min-height: 64px;
      }
      .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none;
        font-family: var(--serif); font-weight: 500; font-size: 1.2rem; color: var(--choco); white-space: nowrap; }
      .brand img { border-radius: 8px; box-shadow: 0 0 0 1px var(--border); }
      .nav-links { display: flex; align-items: center; gap: 0.65rem; white-space: nowrap; }
      .status { font-size: 0.78rem; font-weight: 600; color: var(--positive);
        background: var(--positive-bg); padding: 0.3rem 0.6rem; border-radius: 999px; }
      .ghost { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted);
        text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
      .ghost:hover { color: var(--choco); }

      /* HERO */
      .hero { text-align: center; padding: 4rem 0 2.2rem; display: flex; flex-direction: column; align-items: center; }
      .hero-logo { border-radius: 18px; box-shadow: 0 0 0 1px var(--border), 0 12px 30px rgba(58, 32, 21, 0.12); margin-bottom: 1.6rem; }
      .hero h1 { font-size: clamp(2.2rem, 6vw, 3.8rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 460; max-width: 16ch; }
      .tagline { font-family: var(--serif); font-size: clamp(1.15rem, 2.4vw, 1.4rem); color: var(--choco-2); margin-top: 1rem; }
      .lede { margin: 1.1rem auto 1.6rem; font-size: 1.05rem; color: var(--muted); max-width: 56ch; }
      .meta { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.6rem; font-size: 0.9rem; }
      .meta li span { color: var(--faint); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
        font-weight: 600; margin-right: 0.45rem; }

      /* MARCOS Y ZOOM (mismo patrón que pdf-tool) */
      .showcase { padding: 1rem 0 2rem; }
      .showcase .frame { max-width: 940px; margin: 0 auto; }
      .note { text-align: center; font-size: 0.78rem; color: var(--faint); margin-top: 0.9rem; }
      .frame {
        position: relative; display: block; width: 100%; padding: 0; overflow: hidden;
        background: var(--card); border: 1px solid var(--frame); border-radius: 14px;
        box-shadow: 0 24px 50px rgba(58, 32, 21, 0.14);
        font: inherit; color: inherit; cursor: zoom-in;
      }
      .frame img { width: 100%; }
      .zoomable:focus-visible { outline: 3px solid var(--cocoa); outline-offset: 4px; }
      .zoom-hint {
        position: absolute; right: 12px; bottom: 12px; padding: 0.35rem 0.75rem;
        border-radius: 999px; background: rgba(43, 29, 22, 0.82); color: var(--cream);
        font-size: 0.8rem; font-weight: 600; opacity: 0; transition: opacity 0.2s; pointer-events: none;
      }
      .zoomable:hover .zoom-hint, .zoomable:focus-visible .zoom-hint { opacity: 1; }
      @media (hover: none) { .zoom-hint { opacity: 1; } }

      /* PROBLEMA */
      .problem { text-align: center; }
      .problem h2 { max-width: 24ch; margin: 0 auto; }

      /* CARRUSEL */
      .tour { border-top: 1px solid var(--border); }
      .carousel { margin-top: 2.4rem; }
      .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; margin-bottom: 1.4rem; }
      .tab {
        border: 1px solid var(--border); background: var(--card); color: var(--muted);
        border-radius: 999px; padding: 0.45rem 1rem; font-size: 0.9rem; font-weight: 500; cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
      }
      .tab:hover { border-color: var(--frame); color: var(--choco); }
      .tab[aria-current='true'] { background: var(--choco); border-color: var(--choco); color: var(--cream); }
      .viewport { position: relative; min-width: 0; }
      .track {
        display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
        scrollbar-width: none; padding: 0.5rem 0 1rem;
      }
      .track::-webkit-scrollbar { display: none; }
      .track:focus-visible { outline: 3px solid var(--cocoa); outline-offset: 2px; border-radius: 14px; }
      .slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: center; padding: 0 clamp(0rem, 4vw, 3.4rem); }
      .slide .frame { box-shadow: 0 14px 30px rgba(58, 32, 21, 0.12); }
      .slide img { aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
      .slide .frame::after {
        content: ''; position: absolute; inset: auto 0 0; height: 56px; pointer-events: none;
        background: linear-gradient(to top, rgba(251, 246, 238, 0.9), transparent);
      }
      .slide .zoom-hint { z-index: 1; }
      .slide figcaption { max-width: 60ch; margin: 1.2rem auto 0; text-align: center; }
      .slide figcaption strong { display: block; font-family: var(--serif); font-weight: 500; font-size: 1.2rem; color: var(--choco); }
      .slide figcaption span { display: block; color: var(--muted); font-size: 0.95rem; margin-top: 0.3rem; }
      .arrow {
        position: absolute; top: calc(0.5rem + (100% - 9rem) / 2); z-index: 2; transform: translateY(-50%);
        width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--frame);
        background: var(--card); color: var(--choco); font-size: 1.5rem; line-height: 1; cursor: pointer;
        box-shadow: 0 6px 16px rgba(58, 32, 21, 0.12); transition: opacity 0.2s;
      }
      .arrow.prev { left: 0; }
      .arrow.next { right: 0; }
      .arrow:disabled { opacity: 0.3; cursor: default; }

      .phones { display: flex; justify-content: center; gap: 2rem; margin-top: 3rem; flex-wrap: wrap; }
      .phone { width: min(260px, 100%); }
      .phone .frame { border-radius: 28px; }
      .phone figcaption { text-align: center; color: var(--muted); font-size: 0.9rem; margin-top: 0.9rem; }

      /* POR DENTRO */
      .inside { border-top: 1px solid var(--border); }
      .chips { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin: 2rem auto 0; max-width: 760px; }
      .chips li { font-family: var(--mono); font-size: 0.8rem; color: var(--choco); background: var(--surface);
        border-radius: 999px; padding: 0.35rem 0.85rem; }
      .decisions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.4rem; }
      .decision { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.4rem; }
      .decision h3 { font-size: 1.1rem; margin-bottom: 0.45rem; }
      .decision p { color: var(--muted); font-size: 0.92rem; }

      /* CIERRE */
      .closing { border-top: 1px solid var(--border); }
      .status-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; max-width: 760px; margin: 0 auto; }
      .status-cols h3 { font-size: 1.15rem; margin-bottom: 0.8rem; }
      .status-cols ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
      .status-cols li { font-size: 0.95rem; color: var(--muted); padding-left: 1.4rem; position: relative; }
      .status-cols li::before { content: '✓'; position: absolute; left: 0; color: var(--positive); font-weight: 700; }
      .status-cols .todo li::before { content: '→'; color: var(--cocoa); }
      .cta { text-align: center; margin-top: 4rem; }
      .cta h2 { max-width: 26ch; margin: 0 auto; }
      .cta p { color: var(--muted); margin: 0.9rem auto 1.8rem; max-width: 52ch; }
      .btn { display: inline-flex; align-items: center; text-decoration: none; font-weight: 600;
        color: var(--cream); background: var(--choco-2); padding: 0.85rem 1.6rem; border-radius: 10px;
        transition: transform 0.2s ease, background 0.2s ease; }
      .btn:hover { transform: translateY(-2px); background: var(--choco); }

      /* FOOTER */
      .foot { max-width: 1080px; margin: 0 auto; padding: 2rem clamp(1rem, 4vw, 1.5rem) 3rem;
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem;
        border-top: 1px solid var(--border); color: var(--muted); font-size: 0.85rem; }
      .foot-brand { display: inline-flex; align-items: center; gap: 0.5rem; }
      .foot-brand img { border-radius: 5px; }
      .foot a { color: var(--choco); font-weight: 600; text-decoration: none; }

      /* LIGHTBOX */
      .lightbox {
        border: 0; padding: 0; background: transparent; color: var(--cream);
        width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0;
        overflow-y: auto; overscroll-behavior: contain;
      }
      .lightbox::backdrop { background: rgba(28, 18, 12, 0.86); backdrop-filter: blur(4px); }
      .lb-inner { min-height: 100%; display: flex; align-items: flex-start; justify-content: center; padding: 4rem 4.5rem 3.5rem; }
      .lb-inner img {
        width: min(100%, 1400px); height: auto; margin: auto 0;
        border-radius: 12px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
      }
      .lightbox.fit .lb-inner { align-items: center; }
      .lightbox.fit .lb-inner img { width: auto; max-width: 100%; max-height: calc(100dvh - 7.5rem); border-radius: 24px; }
      .lb-close, .lb-nav {
        position: fixed; z-index: 1; border: 0; border-radius: 50%; background: var(--cream); color: var(--choco);
        cursor: pointer; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
      }
      .lb-close { top: 14px; right: 14px; width: 40px; height: 40px; font-size: 1rem; }
      .lb-nav { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; font-size: 1.6rem; line-height: 1; }
      .lb-prev { left: 12px; }
      .lb-next { right: 12px; }
      .lb-nav:disabled { opacity: 0.3; cursor: default; }
      .lb-count { position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%);
        font-family: var(--mono); font-size: 0.8rem; background: rgba(0, 0, 0, 0.5); padding: 0.2rem 0.7rem; border-radius: 999px; }
      .lb-count:empty { display: none; }

      /* MOTION */
      .rise { opacity: 0; transform: translateY(14px);
        animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; animation-delay: var(--d, 0ms); }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }
      .block { opacity: 0; transform: translateY(20px);
        transition: opacity 0.7s cubic-bezier(0.2,0.7,0.2,1), transform 0.7s cubic-bezier(0.2,0.7,0.2,1); }
      .block.in { opacity: 1; transform: translateY(0); }

      @media (max-width: 880px) {
        .decisions { grid-template-columns: 1fr; }
      }
      @media (max-width: 720px) {
        .slide { padding: 0; }
        .arrow { display: none; }
        .status-cols { grid-template-columns: 1fr; }
        .lb-inner { padding: 3.8rem 0.75rem 4.5rem; }
        .lightbox.fit .lb-inner img { max-height: calc(100dvh - 8.3rem); }
        .lb-nav { top: auto; bottom: 10px; transform: none; width: 44px; height: 44px; }
        .lb-prev { left: 16px; }
        .lb-next { right: 16px; }
      }
      @media (max-width: 420px) {
        .nav-links .status { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rise { animation: none; opacity: 1; transform: none; }
        .block { transition: none; opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
