  /* ── MOBILE TOC (oculto en desktop) ── */
  .toc-mobile { display: none; }

  @media (max-width: 860px) {
    .wrap {
      grid-template-columns: 1fr;
      gap: 0;
      padding: clamp(1.5rem, 4vh, 2.5rem) clamp(1rem, 4vw, 1.5rem) 3rem;
