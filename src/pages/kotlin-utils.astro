  }

  /* ── CONTENT ── */
  .content { min-width: 0; max-width: 720px; }
  .block { margin-top: clamp(3rem, 9vh, 5rem); scroll-margin-top: 4.5rem; }

  /* ── ANCHOR LINKS (#) junto a headers ── */
  .anchor {
