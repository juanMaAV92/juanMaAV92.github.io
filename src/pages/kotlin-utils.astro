  .toc::-webkit-scrollbar { width: 4px; }
  .toc::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }
  .toc-title {
    color: var(--muted); font-size: 0.72rem; letter-spacing: 0.08em;
