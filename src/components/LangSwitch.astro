---
// Selector EN | ES: lleva a la MISMA página en el otro idioma. Hereda color y fuente del contexto;
// cada página puede ajustarlo con las variables --ls-active / --ls-hover.
import { LANGS, LANG_NAMES, localePath, type Lang } from '../i18n/site';
interface Props { lang: Lang; path: string; class?: string }
const { lang, path, class: className } = Astro.props;
const label = lang === 'es' ? 'Idioma' : 'Language';
---
<span class:list={['lang-switch', className]} role="group" aria-label={label}>
  {LANGS.map((l, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">|</span>}
      {l === lang ? (
        <span class="ls-item is-current" aria-current="true">{l.toUpperCase()}</span>
      ) : (
        <a class="ls-item" href={localePath(l, path)} hreflang={l} lang={l} title={LANG_NAMES[l]}>{l.toUpperCase()}</a>
      )}
    </>
  ))}
</span>
<style>
  .lang-switch { display: inline-flex; align-items: center; gap: 0.15rem; font-size: 0.78rem; letter-spacing: 0.04em; white-space: nowrap; }
  .sep { opacity: 0.35; }
  .ls-item { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; min-height: 44px; padding: 0 0.3rem; color: inherit; text-decoration: none; opacity: 0.65; transition: opacity 0.15s, color 0.15s; }
  a.ls-item:hover { opacity: 1; color: var(--ls-hover, inherit); }
  .ls-item.is-current { opacity: 1; font-weight: 700; color: var(--ls-active, inherit); }
</style>
